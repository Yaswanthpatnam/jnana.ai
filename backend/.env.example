# Google Gemini API Key (Free tier from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Connection String (From Supabase Project Settings -> Database -> URI)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
